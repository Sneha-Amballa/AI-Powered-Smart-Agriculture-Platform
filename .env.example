# ==============================================================================
# AI-Powered Smart Agriculture Platform - Root Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and app/.env to configure each tier.

# Backend (FastAPI + PostgreSQL / Supabase)
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./smart_agriculture.db
# PostgreSQL / Supabase example:
# DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Deployed ML Crop Recommendation API (COMPLETED & HOSTED)
CROP_RECOMMENDATION_API_URL=https://crop-recommendation-system-0c1p.onrender.com

# External Service Keys
WEATHER_API_KEY=your_weather_api_key
GEMINI_API_KEY=your_gemini_api_key

# Mobile App (Flutter)
# For Android Emulator use 10.0.2.2:8000, for iOS/Web use localhost:8000
FLUTTER_API_BASE_URL=http://10.0.2.2:8000/api/v1
