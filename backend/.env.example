# ==============================================================================
# Smart Agriculture Platform - Backend Environment Variables
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL / Supabase)
# For local PostgreSQL: postgresql://postgres:yourpassword@localhost:5432/smart_agri_db
# For Supabase: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Default fallback to SQLite enables zero-setup immediate local testing
DATABASE_URL=sqlite:///./smart_agriculture.db
DB_ECHO=false

# Supabase API (Optional - for direct Supabase Auth/Storage SDK usage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Machine Learning Crop Recommendation API (COMPLETED AND DEPLOYED)
# Hosted live model endpoint on Render
CROP_RECOMMENDATION_API_URL=https://crop-recommendation-system-0c1p.onrender.com

# External Agromet & Weather API (e.g. OpenWeatherMap / IMD)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# AI Agronomist Chatbot (Google Gemini / OpenAI API)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication & Security
SECRET_KEY=generate_a_secure_random_key_using_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma separated or * for dev)
BACKEND_CORS_ORIGINS=["*"]
